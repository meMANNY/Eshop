# Admin panel (port 3002). Copy to `.env`.
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put a secret here.

NEXT_PUBLIC_SERVER_URI="http://localhost:8080"
# logger-service. Not 6008 — that is chatting-service, and pointing here
# subscribes the log console to the chat socket, where no log line ever arrives.
NEXT_PUBLIC_SOCKET_URI="ws://localhost:6007"
NEXT_PUBLIC_USER_UI_LINK="http://localhost:3000"
