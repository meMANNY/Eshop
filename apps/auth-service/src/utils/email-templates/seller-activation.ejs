<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>Verify your Eshop seller account</title>
    <style>
        body { margin: 0; padding: 0; width: 100%; background-color: #faf6f4; }
        table { border-collapse: collapse; }
        img { border: 0; line-height: 100%; outline: none; text-decoration: none; }
        a { text-decoration: none; }
        @media only screen and (max-width: 620px) {
            .card { width: 100% !important; border-radius: 0 !important; }
            .pad { padding-left: 26px !important; padding-right: 26px !important; }
            .tile { width: 48px !important; height: 56px !important; font-size: 26px !important; line-height: 56px !important; }
        }
    </style>
</head>
<body style="margin:0; padding:0; background-color:#faf6f4;">
    <!-- preheader (hidden preview text) -->
    <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:#faf6f4; font-size:1px; line-height:1px;">
        Your Eshop seller verification code is inside. It expires in 5 minutes.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#faf6f4;">
        <tr>
            <td align="center" style="padding:40px 16px;">

                <!-- card -->
                <table role="presentation" class="card" width="600" cellpadding="0" cellspacing="0" style="width:600px; max-width:600px; background-color:#ffffff; border-radius:20px; overflow:hidden; box-shadow:0 18px 40px -18px rgba(224,87,74,0.35);">

                    <!-- header -->
                    <tr>
                        <td align="center" style="background-color:#ff6f61; background-image:linear-gradient(135deg,#ff6f61 0%,#ff8a5b 100%); padding:38px 32px;">
                            <span style="font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:27px; font-weight:800; letter-spacing:-0.5px; color:#ffffff;">Eshop</span>
                            <span style="display:inline-block; margin-left:10px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#ffffff; border:1px solid rgba(255,255,255,0.55); border-radius:999px; padding:4px 10px; vertical-align:middle;">Seller</span>
                        </td>
                    </tr>

                    <!-- body -->
                    <tr>
                        <td class="pad" style="padding:44px 48px 8px 48px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                            <p style="margin:0 0 10px 0; text-align:center; font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#ff6f61;">Seller verification</p>
                            <h1 style="margin:0 0 18px 0; text-align:center; font-size:26px; font-weight:800; color:#2b2320;">Verify your seller account</h1>
                            <p style="margin:0 0 6px 0; text-align:center; font-size:16px; line-height:1.6; color:#6b615c;">
                                Hi <%= name %>, welcome to Eshop Seller. Enter the code below to activate your account and set up your shop.
                            </p>
                        </td>
                    </tr>

                    <!-- OTP hero panel -->
                    <tr>
                        <td class="pad" style="padding:22px 48px 8px 48px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fff6f4; border:1px solid #ffe2dc; border-radius:16px;">
                                <tr>
                                    <td align="center" style="padding:30px 20px 26px 20px;">
                                        <!-- digit tiles -->
                                        <table role="presentation" align="center" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <% otp.toString().split('').forEach(function(digit){ %>
                                                <td style="padding:0 6px;">
                                                    <div class="tile" style="width:56px; height:64px; line-height:64px; text-align:center; background-color:#ffffff; border:2px solid #ffd0c8; border-radius:12px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:30px; font-weight:800; color:#e0574a; box-shadow:0 4px 10px -4px rgba(224,87,74,0.3);"><%= digit %></div>
                                                </td>
                                                <% }) %>
                                            </tr>
                                        </table>
                                        <!-- expiry badge -->
                                        <div style="margin-top:22px;">
                                            <span style="display:inline-block; background-color:#ffece8; color:#c94a3d; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.3px; padding:7px 14px; border-radius:999px;">&#9201; Expires in 5 minutes</span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- helper -->
                    <tr>
                        <td class="pad" style="padding:20px 48px 40px 48px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                            <p style="margin:0; text-align:center; font-size:14px; line-height:1.6; color:#9a908a;">
                                Didn't sign up as a seller? You can safely ignore this email.
                            </p>
                        </td>
                    </tr>

                    <!-- footer -->
                    <tr>
                        <td style="padding:24px 48px; background-color:#fbf4f2; border-top:1px solid #f2e6e2; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                            <p style="margin:0 0 4px 0; text-align:center; font-size:13px; font-weight:700; color:#2b2320;">Eshop Seller</p>
                            <p style="margin:0; text-align:center; font-size:12px; line-height:1.5; color:#a99f99;">
                                This is an automated message — please don't reply.<br>
                                &copy; 2026 Eshop. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>
                <!-- /card -->

            </td>
        </tr>
    </table>
</body>
</html>
