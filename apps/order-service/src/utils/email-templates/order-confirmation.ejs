<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>Your Eshop order is confirmed</title>
    <style>
        body { margin: 0; padding: 0; width: 100%; background-color: #faf6f4; }
        table { border-collapse: collapse; }
        img { border: 0; line-height: 100%; outline: none; text-decoration: none; }
        a { text-decoration: none; }
        @media only screen and (max-width: 620px) {
            .card { width: 100% !important; border-radius: 0 !important; }
            .pad { padding-left: 26px !important; padding-right: 26px !important; }
        }
    </style>
</head>
<body style="margin:0; padding:0; background-color:#faf6f4;">
    <!-- preheader (hidden preview text) -->
    <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:#faf6f4; font-size:1px; line-height:1px;">
        Thanks for your order — here's what's on the way.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#faf6f4;">
        <tr>
            <td align="center" style="padding:40px 16px;">

                <!-- card -->
                <table role="presentation" class="card" width="600" cellpadding="0" cellspacing="0" style="width:600px; max-width:600px; background-color:#ffffff; border-radius:20px; overflow:hidden; box-shadow:0 18px 40px -18px rgba(224,87,74,0.35);">

                    <!-- header -->
                    <tr>
                        <td align="center" style="background-color:#ff6f61; background-image:linear-gradient(135deg,#ff6f61 0%,#ff8a5b 100%); padding:38px 32px;">
                            <span style="font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:27px; font-weight:800; letter-spacing:-0.5px; color:#ffffff;">Eshop</span>
                        </td>
                    </tr>

                    <!-- intro -->
                    <tr>
                        <td class="pad" style="padding:44px 48px 8px 48px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                            <p style="margin:0 0 10px 0; text-align:center; font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#ff6f61;">Order confirmed</p>
                            <h1 style="margin:0 0 18px 0; text-align:center; font-size:26px; font-weight:800; color:#2b2320;">Thanks, <%= name %>!</h1>
                            <p style="margin:0 0 6px 0; text-align:center; font-size:16px; line-height:1.6; color:#6b615c;">
                                We've received your payment and your order is being prepared. You'll get another note as soon as it ships.
                            </p>
                        </td>
                    </tr>

                    <!-- order summary -->
                    <tr>
                        <td class="pad" style="padding:26px 48px 8px 48px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fff6f4; border:1px solid #ffe2dc; border-radius:16px;">
                                <tr>
                                    <td style="padding:24px 24px 8px 24px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                                        <p style="margin:0 0 16px 0; font-size:12px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#c94a3d;">Order summary</p>

                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                                            <% (cart || []).forEach(function(item){ %>
                                            <tr>
                                                <td style="padding:10px 0; border-bottom:1px solid #ffe2dc; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:14px; color:#2b2320;">
                                                    <span style="font-weight:600;"><%= item.title || 'Item' %></span>
                                                    <span style="color:#9a908a;">&times; <%= item.quantity %></span>
                                                </td>
                                                <td align="right" style="padding:10px 0; border-bottom:1px solid #ffe2dc; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:14px; font-weight:600; color:#2b2320; white-space:nowrap;">
                                                    $<%= (Number(item.sale_price) * Number(item.quantity)).toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                            <tr>
                                                <td style="padding:16px 0 4px 0; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:15px; font-weight:700; color:#2b2320;">
                                                    Total paid
                                                </td>
                                                <td align="right" style="padding:16px 0 4px 0; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:20px; font-weight:800; color:#e0574a; white-space:nowrap;">
                                                    $<%= Number(totalAmount).toFixed(2) %>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- CTA -->
                    <tr>
                        <td class="pad" style="padding:26px 48px 8px 48px;" align="center">
                            <a href="<%= trackingUrl %>" style="display:inline-block; background-color:#ff6f61; color:#ffffff; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:15px; font-weight:700; padding:14px 34px; border-radius:999px; box-shadow:0 8px 18px -8px rgba(224,87,74,0.6);">
                                Track your order
                            </a>
                        </td>
                    </tr>

                    <!-- helper -->
                    <tr>
                        <td class="pad" style="padding:20px 48px 40px 48px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                            <p style="margin:0; text-align:center; font-size:14px; line-height:1.6; color:#9a908a;">
                                You can also find this order any time under Profile &rsaquo; My Orders.
                            </p>
                        </td>
                    </tr>

                    <!-- footer -->
                    <tr>
                        <td style="padding:24px 48px; background-color:#fbf4f2; border-top:1px solid #f2e6e2; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                            <p style="margin:0 0 4px 0; text-align:center; font-size:13px; font-weight:700; color:#2b2320;">Eshop</p>
                            <p style="margin:0; text-align:center; font-size:12px; line-height:1.5; color:#a99f99;">
                                This is an automated message — please don't reply.<br>
                                &copy; 2026 Eshop. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>
                <!-- /card -->

            </td>
        </tr>
    </table>
</body>
</html>
