# Backend services. Copy to `.env` and fill in.
# The three Next apps each read their own file — see apps/*/.env.example.

# ---- Database & cache -------------------------------------------------------
DATABASE_URL="mongodb+srv://user:password@cluster.example.mongodb.net/eshop"
REDIS_URL="redis://localhost:6379"

# ---- Auth -------------------------------------------------------------------
# Both are HS256 signing keys. Generate with:  openssl rand -base64 48
ACCESS_TOKEN_SECRET="replace-with-access-token-secret"
REFRESH_TOKEN_SECRET="replace-with-refresh-token-secret"

# ---- Email (OTP, order confirmations, password reset) -----------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SERVICE="gmail"
SMTP_USER="your-address@example.com"
SMTP_PASSWORD="replace-with-app-password"

# ---- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_replace_me"
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it the order webhook rejects every event.
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# ---- ImageKit ---------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY="public_replace_me"
IMAGEKIT_PRIVATE_KEY="private_replace_me"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# ---- Kafka (Confluent) ------------------------------------------------------
# Comma-separated for a multi-broker cluster.
KAFKA_BROKER="pkc-example.region.provider.confluent.cloud:9092"
KAFKA_API_KEY="replace-with-kafka-api-key"
KAFKA_API_SECRET="replace-with-kafka-api-secret"
# Port for kafka-service's HTTP /track ingest endpoint.
KAFKA_HTTP_PORT="6010"

# ---- Service discovery ------------------------------------------------------
# The api-gateway proxies to these. Each defaults to the localhost value below,
# so a local checkout needs none of them; a deploy needs all seven.
AUTH_SERVICE_URL="http://localhost:6001"
PRODUCT_SERVICE_URL="http://localhost:6002"
ORDER_SERVICE_URL="http://localhost:6004"
ADMIN_SERVICE_URL="http://localhost:6005"
RECOMMENDATION_SERVICE_URL="http://localhost:6006"
CHAT_SERVICE_URL="http://localhost:6008"
SELLER_SERVICE_URL="http://localhost:6009"

# Where Stripe returns a seller after Connect onboarding.
SELLER_UI_URL="http://localhost:3001"

# ---- CORS -------------------------------------------------------------------
# Comma-separated allowlist shared by the gateway and every service. Defaults to
# localhost:3000/3001/3002 when unset, which is what local development wants.
CORS_ORIGIN="https://shop.example.com,https://seller.example.com,https://admin.example.com"

# ---- Runtime ----------------------------------------------------------------
NODE_ENV="development"
